# ======================================================
# Muta7 Market Server - Environment Configuration
# Copy this file to .env and fill in your values
# ======================================================

# ----- Server -----
NODE_ENV=development                 # development | production | test
PORT=5000                            # HTTP port
API_PREFIX=/api/v1                   # API base path
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=false                    # set true when behind reverse proxy (nginx/load balancer)

# ----- Database (required) -----
MONGODB_URI=mongodb://127.0.0.1:27017/muta7market

# ----- JWT (required - use strong secrets in production) -----
JWT_ACCESS_SECRET=your-strong-access-secret-at-least-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=your-strong-refresh-secret-at-least-32-chars
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=muta7market

# ----- Redis (optional - caching + socket.io scaling) -----
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# ----- Elasticsearch (optional - advanced scouting engine, falls back to MongoDB) -----
ELASTIC_ENABLED=false
ELASTIC_URL=http://127.0.0.1:9200
ELASTIC_INDEX_PREFIX=muta7market

# ----- Email (SMTP optional - falls back to console logger in dev) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Muta7 Market <no-reply@muta7market.com>"
FRONTEND_URL=http://localhost:3000   # used in verification/reset email links

# ----- Uploads (local storage, media stays on server per PRD) -----
UPLOAD_DIR=uploads
MAX_VIDEO_SIZE_MB=200
MAX_IMAGE_SIZE_MB=5
MAX_DOC_SIZE_MB=10

# ----- Admin bootstrap (used by `npm run seed`) -----
ADMIN_EMAIL=admin@muta7market.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Platform Admin

# ----- Paylink (Saudi payment gateway) -----
# Get credentials from My Paylink portal (https://my.paylink.sa) -> Developers
# Testing env: https://restapi.paylink.sa  |  Production env: https://restapi.paylink.sa
PAYLINK_BASE_URL=https://restapi.paylink.sa
PAYLINK_API_ID=
PAYLINK_SECRET=
PAYLINK_WEBHOOK_AUTH=                   # custom header value configured in My Paylink portal webhook settings
PAYLINK_PERSIST_TOKEN=true              # true => 30h token, false => 30min
PAYLINK_TIMEOUT_MS=15000
# Dev only: allow marking invoices paid without Paylink (never in production)
PAYMENT_SIMULATION_ENABLED=false

# ----- Security / Rate limiting -----
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10
SEARCH_RATE_LIMIT_MAX=120
